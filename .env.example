# Secrets — copy to .env and fill in. NEVER commit .env (it is gitignored).
#
# Nothing here is needed to run the app or the tests. These are only for
# regenerating training data and publishing releases.

# Optional. Only used by the (now retired) API-based distillation path; the
# current pipeline distils on free Kaggle GPUs instead and needs none of this.
ANTHROPIC_API_KEY=

# Credentials live OUTSIDE this repo, in the tools' own config locations:
#
#   Kaggle           ~/.kaggle/access_token   (chmod 600)   — training runs
#                    get one at kaggle.com/settings > API
#   Hugging Face     ~/.cache/huggingface/token             — publishing weights
#                    `hf auth login`
#
# Model weights are gitignored. ./download_model.sh fetches them from a pinned
# revision and verifies the sha256 before use.
